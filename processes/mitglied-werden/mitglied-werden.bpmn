<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:flowable="http://flowable.org/bpmn"
                  xmlns:pc="https://github.com/EdgusT/process_to_code_to_bpmn/mapping"
                  id="Definitions_MitgliedWerden"
                  targetNamespace="https://github.com/EdgusT/process_to_code_to_bpmn/processes">

  <bpmn:collaboration id="Collaboration_MitgliedWerden">
    <bpmn:participant id="Participant_MitgliedWerden" name="Mitglied werden" processRef="mitglied_werden" />
  </bpmn:collaboration>

  <bpmn:process id="mitglied_werden" name="Mitglied werden" isExecutable="true">
    <bpmn:documentation>Beispielprozess: Eine Person beantragt die Mitgliedschaft im Portal, CiviCRM prüft die Angaben, das Backoffice gibt frei oder die Annahme erfolgt automatisch nach Fristablauf.</bpmn:documentation>

    <bpmn:laneSet id="LaneSet_MitgliedWerden">
      <bpmn:lane id="Lane_Portal" name="Portal">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndUngueltig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndAktiv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndAbgelehnt</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Orchestrierung" name="Orchestrierung">
        <bpmn:flowNodeRef>GwGueltig</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CiviCRM" name="CiviCRM">
        <bpmn:flowNodeRef>Anlegen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Aktivieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ablehnen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backoffice" name="Backoffice">
        <bpmn:flowNodeRef>Freigeben</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Frist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GwFreigabe</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start" name="Antrag abgesendet">
      <bpmn:extensionElements>
        <pc:mapping layer="Experience" ui="Portal-Formular" owner="Frontend-Team"
                    implementation="Das Portal startet den Prozess über die Flowable-REST-API" />
      </bpmn:extensionElements>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Anlegen" name="Angaben prüfen, Mitgliedschaft anlegen"
                      flowable:type="external-worker" flowable:topic="civicrm.membership.create-pending">
      <bpmn:extensionElements>
        <pc:mapping layer="Domain Service" system="CiviCRM" owner="CiviCRM-Team"
                    implementation="Plausibilität und Fachregeln in CiviCRM, legt die Mitgliedschaft mit Status Pending an (API v4)" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="GwGueltig" name="Angaben gültig?" default="F3">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndUngueltig" name="Angaben ungültig">
      <bpmn:incoming>F3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Freigeben" name="Antrag prüfen und freigeben" flowable:candidateGroups="backoffice">
      <bpmn:extensionElements>
        <pc:mapping layer="Orchestration" ui="Portal-Aufgabenliste oder CiviCRM-Maske" owner="Backoffice"
                    implementation="User Task im Orchestrator, beide Oberflächen schließen dieselbe Aufgabe ab" />
      </bpmn:extensionElements>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="Frist" name="nach Fristablauf" cancelActivity="true" attachedToRef="Freigeben">
      <bpmn:extensionElements>
        <pc:mapping layer="Orchestration" owner="Fachbereich"
                    implementation="Timer, Dauer kommt aus dem Parameter autoAcceptAfterDays" />
      </bpmn:extensionElements>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Frist">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${autoAcceptDuration}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="GwFreigabe" name="Freigegeben?" default="F8">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Aktivieren" name="Mitgliedschaft aktivieren"
                      flowable:type="external-worker" flowable:topic="civicrm.membership.activate">
      <bpmn:extensionElements>
        <pc:mapping layer="Domain Service" system="CiviCRM" owner="CiviCRM-Team"
                    implementation="Setzt die Mitgliedschaft auf Current (API v4)" />
      </bpmn:extensionElements>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Ablehnen" name="Antrag ablehnen"
                      flowable:type="external-worker" flowable:topic="civicrm.membership.reject">
      <bpmn:extensionElements>
        <pc:mapping layer="Domain Service" system="CiviCRM" owner="CiviCRM-Team"
                    implementation="Vermerkt die Ablehnung und informiert die Person (API v4)" />
      </bpmn:extensionElements>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndAktiv" name="Mitglied aktiv">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndAbgelehnt" name="Antrag abgelehnt">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Anlegen" />
    <bpmn:sequenceFlow id="F2" sourceRef="Anlegen" targetRef="GwGueltig" />
    <bpmn:sequenceFlow id="F3" name="nein" sourceRef="GwGueltig" targetRef="EndUngueltig" />
    <bpmn:sequenceFlow id="F4" name="ja" sourceRef="GwGueltig" targetRef="Freigeben">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${angabenGueltig}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="Freigeben" targetRef="GwFreigabe" />
    <bpmn:sequenceFlow id="F6" sourceRef="Frist" targetRef="Aktivieren" />
    <bpmn:sequenceFlow id="F7" name="ja" sourceRef="GwFreigabe" targetRef="Aktivieren">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${freigegeben}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" name="nein" sourceRef="GwFreigabe" targetRef="Ablehnen" />
    <bpmn:sequenceFlow id="F9" sourceRef="Ablehnen" targetRef="EndAbgelehnt" />
    <bpmn:sequenceFlow id="F10" sourceRef="Aktivieren" targetRef="EndAktiv" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_MitgliedWerden">
    <bpmndi:BPMNPlane id="Plane_MitgliedWerden" bpmnElement="Collaboration_MitgliedWerden">

      <bpmndi:BPMNShape id="Participant_MitgliedWerden_di" bpmnElement="Participant_MitgliedWerden" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1280" height="560" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Portal_di" bpmnElement="Lane_Portal" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1250" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Orchestrierung_di" bpmnElement="Lane_Orchestrierung" isHorizontal="true">
        <dc:Bounds x="190" y="220" width="1250" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CiviCRM_di" bpmnElement="Lane_CiviCRM" isHorizontal="true">
        <dc:Bounds x="190" y="360" width="1250" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Backoffice_di" bpmnElement="Lane_Backoffice" isHorizontal="true">
        <dc:Bounds x="190" y="500" width="1250" height="140" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="252" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="294" y="141" width="120" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Anlegen_di" bpmnElement="Anlegen">
        <dc:Bounds x="350" y="390" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwGueltig_di" bpmnElement="GwGueltig" isMarkerVisible="true">
        <dc:Bounds x="545" y="265" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="602" y="276" width="100" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndUngueltig_di" bpmnElement="EndUngueltig">
        <dc:Bounds x="552" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="594" y="141" width="120" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Freigeben_di" bpmnElement="Freigeben">
        <dc:Bounds x="670" y="530" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Frist_di" bpmnElement="Frist">
        <dc:Bounds x="682" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="596" y="494" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwFreigabe_di" bpmnElement="GwFreigabe" isMarkerVisible="true">
        <dc:Bounds x="875" y="545" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="860" y="523" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Aktivieren_di" bpmnElement="Aktivieren">
        <dc:Bounds x="980" y="390" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ablehnen_di" bpmnElement="Ablehnen">
        <dc:Bounds x="1210" y="390" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndAktiv_di" bpmnElement="EndAktiv">
        <dc:Bounds x="1032" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1074" y="141" width="100" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndAbgelehnt_di" bpmnElement="EndAbgelehnt">
        <dc:Bounds x="1262" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1304" y="141" width="110" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="270" y="168" /><di:waypoint x="270" y="430" /><di:waypoint x="350" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="420" y="390" /><di:waypoint x="420" y="290" /><di:waypoint x="545" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="570" y="265" /><di:waypoint x="570" y="168" />
        <bpmndi:BPMNLabel><dc:Bounds x="578" y="210" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="570" y="315" /><di:waypoint x="570" y="570" /><di:waypoint x="670" y="570" />
        <bpmndi:BPMNLabel><dc:Bounds x="578" y="530" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="810" y="570" /><di:waypoint x="875" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="700" y="512" /><di:waypoint x="700" y="430" /><di:waypoint x="980" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="925" y="570" /><di:waypoint x="1050" y="570" /><di:waypoint x="1050" y="470" />
        <bpmndi:BPMNLabel><dc:Bounds x="965" y="552" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="900" y="595" /><di:waypoint x="900" y="620" /><di:waypoint x="1280" y="620" /><di:waypoint x="1280" y="470" />
        <bpmndi:BPMNLabel><dc:Bounds x="908" y="602" width="30" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="1280" y="390" /><di:waypoint x="1280" y="168" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10">
        <di:waypoint x="1050" y="390" /><di:waypoint x="1050" y="168" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
